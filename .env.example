# ==================================================
# 1. Ứng dụng và địa chỉ truy cập
# ==================================================
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_PREFIX=api
API_VERSION=1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==================================================
# 2. Cơ sở dữ liệu MySQL
# ==================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_NAME=trung_tam_giang_day
DB_PORT=3306
DATABASE_CONNECT_ON_START=true

# ==================================================
# 3. Google OAuth
# ==================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ==================================================
# 4. Lưu trữ Cloudinary
# ==================================================
STORAGE_PROVIDER=cloudinary
CLOUDINARY_FOLDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_ROOT=
STORAGE_SIGNING_SECRET=local-development-storage-key-change-me

# ==================================================
# 5. Gửi email bằng Resend
# ==================================================
RESEND_API_KEY=
RESEND_FROM=

# ==================================================
# 6. Dữ liệu khởi tạo
# ==================================================
SEED_DEFAULT_PASSWORD=WindEdu@2026!

# ==================================================
# 7. Giới hạn truy cập và ghi log
# ==================================================
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=debug
