# ==================================================
# 1. Ứng dụng và địa chỉ truy cập
# ==================================================
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_PREFIX=api
API_VERSION=1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==================================================
# 2. Cơ sở dữ liệu PostgreSQL
# ==================================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=trung_tam_giang_day
DB_PORT=5432
DATABASE_CONNECT_ON_START=true
# Số kết nối tối đa của pool, thời gian chờ lấy kết nối và trần thời gian mỗi câu lệnh (0 = không giới hạn).
DB_POOL_MAX=30
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# ==================================================
# 3. Lưu trữ Cloudinary
# ==================================================
STORAGE_PROVIDER=cloudinary
CLOUDINARY_FOLDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_ROOT=
STORAGE_SIGNING_SECRET=local-development-storage-key-change-me

# ==================================================
# 4. Gửi email bằng Resend
# ==================================================
RESEND_API_KEY=
RESEND_FROM=

# ==================================================
# 5. Dữ liệu khởi tạo
# ==================================================
# Chỉ dùng cho môi trường phát triển; production phải bỏ trống biến này (seed sẽ tạo admin tạm mật khẩu ngẫu nhiên).
SEED_DEFAULT_PASSWORD=WindEdu@2026!

# ==================================================
# 6. Giới hạn truy cập và ghi log
# ==================================================
RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX đếm theo phiên đăng nhập (hoặc IP khi chưa đăng nhập); RATE_LIMIT_IP_MAX là trần theo IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_IP_MAX=1000
# Số hop proxy tin cậy (ví dụ 1 khi có Nginx) hoặc danh sách IP/CIDR của proxy; false khi API nhận kết nối trực tiếp.
TRUST_PROXY=false
# Giới hạn riêng cho đăng nhập/MFA/đặt lại mật khẩu/OTP, đếm theo cặp IP + tài khoản.
AUTH_RATE_LIMIT_TTL_MS=900000
AUTH_RATE_LIMIT_MAX=5
LOG_LEVEL=debug
