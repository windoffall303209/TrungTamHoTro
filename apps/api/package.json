{
  "name": "@wind-of-fall/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/src/main.js",
    "lint": "pnpm db:generate && eslint src test prisma.config.ts vitest.config.ts --max-warnings=0",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:doctor": "tsx prisma/doctor.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.mjs",
    "db:test:prepare": "node scripts/test-database.mjs prepare",
    "db:test:reset": "node scripts/test-database.mjs reset --confirm",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cloudinary": "2.11.0",
    "compression": "1.8.1",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "mammoth": "1.12.2",
    "mariadb": "3.5.3",
    "reflect-metadata": "0.2.2",
    "resend": "6.5.2",
    "rxjs": "7.8.2",
    "yauzl": "3.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.12",
    "@types/yauzl": "2.10.3",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "jszip": "3.10.1",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.11"
  }
}
