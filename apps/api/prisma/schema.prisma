  provider      String    @unique @db.VarChar(50)
  enabled       Boolean   @default(false)
  credentialRef String?   @map("credential_ref") @db.VarChar(255)
  webhookUrl    String?   @map("webhook_url") @db.VarChar(1000)
  isDefault     Boolean   @default(false) @map("is_default")
  healthStatus  String    @default("UNKNOWN") @map("health_status") @db.VarChar(30)
  lastCheckedAt DateTime? @map("last_checked_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([isDefault, enabled])
  @@map("integration_providers")
}

model BackupJob {
  id          String       @id @default(cuid())
  type        String       @db.VarChar(30)
  status      JobStatus    @default(PENDING)
  checksum    String?      @db.VarChar(128)
  sizeBytes   BigInt?      @map("size_bytes")
  objectKey   String?      @map("object_key") @db.VarChar(500)
  errorMessage String?     @map("error_message") @db.VarChar(500)
  requestedBy  String      @default("system") @map("requested_by") @db.VarChar(191)
  attempts     Int         @default(0)
  progress     Int         @default(0)
  availableAt  DateTime    @default(now()) @map("available_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")
  restores    RestoreJob[]

  @@index([status, createdAt])
  @@index([status, availableAt])
  @@map("backup_jobs")
}

model RestoreJob {
  id           String    @id @default(cuid())
  backupId     String    @map("backup_id")
  mode         String    @default("DRILL") @db.VarChar(30)
  requestedBy  String    @default("system") @map("requested_by") @db.VarChar(191)
  approvedBy   String?   @map("approved_by") @db.VarChar(191)
  reason       String?   @db.VarChar(500)
  targetDatabase String? @map("target_database") @db.VarChar(191)
  approvedAt   DateTime? @map("approved_at")
  status       JobStatus @default(PENDING)
  verification String?   @db.Text
  backup       BackupJob @relation(fields: [backupId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  @@index([status, createdAt])
  @@map("restore_jobs")
}

model DataExportJob {
  id        String    @id @default(cuid())
  category  String    @db.VarChar(100)
  format    String    @db.VarChar(20)
  status    JobStatus @default(PENDING)
  rowCount  Int?      @map("row_count")
  objectKey String?   @map("object_key") @db.VarChar(500)
  checksum  String?   @db.VarChar(128)
  sizeBytes BigInt?   @map("size_bytes")
  errorMessage String? @map("error_message") @db.VarChar(500)
  requestedBy String    @default("system") @map("requested_by") @db.VarChar(191)
  attempts   Int       @default(0)
  progress   Int       @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, expiresAt])
  @@index([status, availableAt])
  @@map("data_export_jobs")
}

model NotificationTemplate {
  id        String        @id @default(cuid())
  eventCode String        @map("event_code") @db.VarChar(100)
  locale    String        @db.VarChar(20)
  subject   String        @db.VarChar(255)
  body      String        @db.Text
  version   Int           @default(1)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([eventCode, locale, version])
  @@index([eventCode, locale, status])
  @@map("notification_templates")
}

model ModerationPolicy {
  id                String   @id @default(cuid())
  version           Int      @unique
  prohibitedTerms   Json     @map("prohibited_terms")
  maxPostsPerMinute Int      @map("max_posts_per_minute")
  action            String   @db.VarChar(50)
  publishedBy       String   @map("published_by") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("moderation_policies")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(191)
  requestId  String?  @map("request_id") @db.VarChar(100)
  context    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model ProgressIntervention {
  id          String             @id @default(cuid())
  classId     String             @map("class_id") @db.VarChar(191)
  learnerId   String             @map("learner_id") @db.VarChar(191)
  ownerId     String             @map("owner_id") @db.VarChar(191)
  createdById String             @map("created_by_id") @db.VarChar(191)
  title       String             @db.VarChar(255)
  notes       String?            @db.Text
  dueAt       DateTime           @map("due_at")
  status      InterventionStatus @default(OPEN)
  outcome     String?            @db.Text
  cancellationReason String?     @map("cancellation_reason") @db.VarChar(1000)
  acceptedAt  DateTime?          @map("accepted_at")
  completedAt DateTime?          @map("completed_at")
  handoffHistory Json            @default("[]") @map("handoff_history")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([classId, learnerId, status])
  @@index([ownerId, dueAt])
  @@map("progress_interventions")
}

model OutboxEvent {
  id            String           @id @db.VarChar(191)
  type          String           @db.VarChar(100)
  aggregateType String           @map("aggregate_type") @db.VarChar(100)
  aggregateId   String           @map("aggregate_id") @db.VarChar(191)
  payload       Json
  deliveries    OutboxDelivery[]
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("outbox_events")
}

model OutboxDelivery {
  id                String      @id @db.VarChar(191)
  eventId           String      @map("event_id") @db.VarChar(191)
  recipientId       String      @map("recipient_id") @db.VarChar(191)
  channel           String      @db.VarChar(30)
  dedupKey          String      @unique @map("dedup_key") @db.VarChar(255)
  status            String      @default("PENDING") @db.VarChar(30)
  attempts          Int         @default(0)
  availableAt       DateTime    @default(now()) @map("available_at")
  providerMessageId String?     @map("provider_message_id") @db.VarChar(191)
  lastError         String?     @map("last_error") @db.VarChar(500)
  deliveredAt       DateTime?   @map("delivered_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  event             OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([recipientId, updatedAt(sort: Desc)])
  @@map("outbox_deliveries")
}

model ChatConversation {
  id          String               @id @default(cuid())
  type        ChatConversationType
  classId     String?              @unique @map("class_id")
  directKey   String?              @unique @map("direct_key") @db.VarChar(383)
  createdById String               @map("created_by_id") @db.VarChar(191)
  class       LearningClass?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  members     ChatConversationMember[]
  messages    ChatMessage[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([type, updatedAt])
  @@map("chat_conversations")
}

model ChatConversationMember {
  conversationId String           @map("conversation_id")
  userId         String           @map("user_id")
  roleSnapshot   String           @map("role_snapshot") @db.VarChar(50)
  status         ChatMemberStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  removedAt      DateTime?        @map("removed_at")
  lastReadAt     DateTime?        @map("last_read_at")
  mutedUntil     DateTime?        @map("muted_until")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, status])
  @@map("chat_conversation_members")
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String           @map("conversation_id")
  senderId        String           @map("sender_id")
  clientMessageId String           @map("client_message_id") @db.VarChar(100)
  content         String           @db.Text
  replyToId       String?          @map("reply_to_id")
  contextType     String?          @map("context_type") @db.VarChar(30)
  contextId       String?          @map("context_id") @db.VarChar(191)
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo         ChatMessage?     @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]    @relation("ChatMessageReplies")
  attachments     ChatMessageAttachment[]
  mentions        ChatMessageMention[]
  reports         ChatMessageReport[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ChatMessageAttachment {
  id          String      @id @default(cuid())
  messageId   String      @map("message_id")
  objectKey   String      @unique @map("object_key") @db.VarChar(500)
  originalName String     @map("original_name") @db.VarChar(255)
  mimeType    String      @map("mime_type") @db.VarChar(150)
  sizeBytes   BigInt      @map("size_bytes")
  checksum    String      @db.VarChar(128)
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([messageId, createdAt])
  @@map("chat_message_attachments")
}

model ChatMessageMention {
  messageId       String      @map("message_id")
  mentionedUserId String      @map("mentioned_user_id") @db.VarChar(191)
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @map("created_at")

  @@id([messageId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
  @@map("chat_message_mentions")
}

model ChatMessageReport {
  id         String      @id @default(cuid())
  messageId  String      @map("message_id")
  reporterId String      @map("reporter_id") @db.VarChar(191)
  reason     String      @db.VarChar(1000)
  status     String      @default("OPEN") @db.VarChar(30)
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@map("chat_message_reports")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.VarChar(191)
  blockedId String   @map("blocked_id") @db.VarChar(191)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("user_blocks")
}

model ReportRun {
  id                String   @id @default(cuid())
  reportType        String   @map("report_type") @db.VarChar(50)
  definitionVersion String   @map("definition_version") @db.VarChar(30)
  timezone          String   @db.VarChar(80)
  filters           Json
  result            Json
  requestedById     String   @map("requested_by_id") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at")
  exports            ReportExport[]

  @@index([reportType, createdAt])
  @@index([requestedById, createdAt])
  @@map("report_runs")
}

model ReportExport {
  id            String             @id @default(cuid())
  reportRunId   String             @map("report_run_id")
  format        String             @db.VarChar(20)
  status        ReportExportStatus @default(QUEUED)
  fileName      String             @map("file_name") @db.VarChar(255)
  filePath      String?            @map("file_path") @db.VarChar(1000)
  sizeBytes     BigInt?            @map("size_bytes")
  errorMessage  String?            @map("error_message") @db.Text
  expiresAt     DateTime           @map("expires_at")
  requestedById String             @map("requested_by_id") @db.VarChar(191)
  reportRun     ReportRun          @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([requestedById, createdAt])
  @@index([status, expiresAt])
  @@map("report_exports")
}
