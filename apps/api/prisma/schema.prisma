generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  LOCKED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ClassStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstructorAssignmentRole {
  PRIMARY
  CO_INSTRUCTOR
}

enum MaterialScope {
  SHARED
  CLASS
}

enum MaterialVisibility {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ExamStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  RESOLVED
  REJECTED
}

enum ReportExportStatus {
  QUEUED
  COMPLETED
  FAILED
  EXPIRED
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Severity {
  P0
  P1
  P2
  P3
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RegradeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum AttendanceAppealStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_LOGIN
  MFA_DISABLE
  PASSWORD_CHANGE_OTP
  MFA_SETUP_OTP
  MFA_DISABLE_OTP
  ACCOUNT_SETUP
  ACCOUNT_SETUP_OTP
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

enum ChatConversationType {
  DIRECT
  CLASS
}

enum ChatMemberStatus {
  ACTIVE
  REMOVED
}

model User {
  id                       String              @id @default(cuid())
  username                 String              @unique @db.VarChar(191)
  email                    String?             @unique @db.VarChar(191)
  passwordHash             String?             @map("password_hash") @db.VarChar(255)
  googleSubject            String?             @unique @map("google_subject") @db.VarChar(255)
  displayName              String              @map("display_name") @db.VarChar(150)
  phone                    String?             @db.VarChar(30)
  timezone                 String              @default("Asia/Bangkok") @db.VarChar(80)
  locale                   String              @default("vi-VN") @db.VarChar(20)
  avatarObjectKey          String?             @unique @map("avatar_object_key") @db.VarChar(500)
  avatarMimeType           String?             @map("avatar_mime_type") @db.VarChar(50)
  avatarUpdatedAt          DateTime?           @map("avatar_updated_at")
  status                   UserStatus          @default(ACTIVE)
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  emailVerifiedAt          DateTime?           @map("email_verified_at")
  mfaSecretEncrypted       String?             @map("mfa_secret_encrypted") @db.Text
  mfaEnabledAt             DateTime?           @map("mfa_enabled_at")
  roles                    UserRole[]
  ownedCourses             Course[]            @relation("CourseOwner")
  instructedClasses        ClassInstructor[]
  enrollments              ClassEnrollment[]
  materials                Material[]          @relation("MaterialOwner")
  materialEditorships      MaterialEditor[]    @relation("MaterialEditorUser")
  materialAccessLogs       MaterialAccessLog[]
  regradeRequests          RegradeRequest[]
  questions                Question[]          @relation("QuestionAuthor")
  examAttempts             ExamAttempt[]       @relation("AttemptLearner")
  forumTopics              ForumTopic[]        @relation("TopicAuthor")
  forumPosts               ForumPost[]         @relation("PostAuthor")
  forumMentions            ForumMention[]      @relation("MentionedUser")
  notifications            Notification[]      @relation("NotificationRecipient")
  contentReports           ContentReport[]     @relation("ReportAuthor")
  hostedSessions           LiveSession[]       @relation("SessionHost")
  lockedAttendanceSessions LiveSession[]       @relation("AttendanceLocker")
  attendance               AttendanceRecord[]
  attendanceAppeals        AttendanceAppeal[]
  reportedTickets          SupportTicket[]     @relation("TicketReporter")
  assignedTickets          SupportTicket[]     @relation("TicketAssignee")
  ticketComments           TicketComment[]     @relation("TicketCommentAuthor")
  ticketAttachments        SupportAttachment[] @relation("TicketAttachmentUploader")
  materialReviews          FileReview[]        @relation("MaterialReviewer")
  examApprovals            ExamApproval[]      @relation("ExamReviewer")
  auditLogs                AuditLog[]
  authSessions             AuthSession[]
  accountTokens            AccountToken[]
  mfaRecoveryCodes         MfaRecoveryCode[]
  createdAssignments       Assignment[]        @relation("AssignmentCreator")
  assignmentSubmissions    AssignmentSubmission[] @relation("AssignmentLearner")
  classAnnouncements       ClassAnnouncement[] @relation("AnnouncementAuthor")
  chatMemberships          ChatConversationMember[]
  chatMessages             ChatMessage[]        @relation("ChatMessageSender")
  aiStudyDrafts            AiStudyDraft[]
  aiGradingSuggestions     AiGradingSuggestion[]

  @@map("users")
}

model AuthSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash   String?   @map("csrf_token_hash") @db.Char(64)
  userId          String    @map("user_id")
  currentRoleCode String    @map("current_role_code") @db.VarChar(50)
  expiresAt       DateTime  @map("expires_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  userAgent       String?   @map("user_agent") @db.VarChar(500)
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model AccountToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  codeHash   String?          @map("code_hash") @db.Char(64)
  failedAttempts Int          @default(0) @map("failed_attempts")
  type       AccountTokenType
  userId     String           @map("user_id")
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("account_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  userId    String    @map("user_id")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  version     Int              @default(1)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Course {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(50)
  name        String          @db.VarChar(200)
  description String          @db.Text
  outcomes    Json
  status      CourseStatus    @default(DRAFT)
  version     Int             @default(1)
  ownerId     String          @map("owner_id")
  owner       User            @relation("CourseOwner", fields: [ownerId], references: [id])
    classes     LearningClass[]
    versions    CourseVersion[]
  questions   Question[]
  materials   Material[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([ownerId, status])
  @@map("courses")
}

model CourseVersion {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  version     Int
  name        String   @db.VarChar(200)
  description String   @db.Text
  outcomes    Json
  publishedBy String   @map("published_by") @db.VarChar(191)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now()) @map("published_at")

  @@unique([courseId, version])
  @@index([courseId, publishedAt])
  @@map("course_versions")
}

model LearningClass {
    id            String            @id @default(cuid())
    courseId      String            @map("course_id")
    courseVersion Int               @map("course_version")
    code          String            @db.VarChar(50)
  name          String            @db.VarChar(200)
  term          String            @db.VarChar(50)
  startAt       DateTime          @map("start_at")
  endAt         DateTime          @map("end_at")
    capacity      Int
    timezone      String            @default("Asia/Bangkok") @db.VarChar(80)
    allowLateEnrollment Boolean     @default(false) @map("allow_late_enrollment")
  status        ClassStatus       @default(DRAFT)
  closeReason   String?           @map("close_reason") @db.VarChar(500)
  archivePolicy String?           @map("archive_policy") @db.VarChar(50)
  closedAt      DateTime?         @map("closed_at")
  archivedAt    DateTime?         @map("archived_at")
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructors   ClassInstructor[]
  instructorHistory ClassInstructorHistory[]
  enrollments   ClassEnrollment[]
  enrollmentHistory ClassEnrollmentHistory[]
  materials     Material[]
  exams         Exam[]
  forumTopics   ForumTopic[]
  sessions      LiveSession[]
  assignments   Assignment[]
  announcements ClassAnnouncement[]
  chatConversation ChatConversation?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

    @@index([courseId, status])
    @@index([term])
    @@unique([code, term])
  @@map("learning_classes")
}

model Assignment {
  id          String           @id @default(cuid())
  classId     String           @map("class_id")
  createdById String           @map("created_by_id")
  title       String           @db.VarChar(255)
  description String           @db.Text
  instructions String          @db.Text
  dueAt       DateTime         @map("due_at")
  maxScore    Decimal          @map("max_score") @db.Decimal(8, 2)
  rubric      Json
  status      AssignmentStatus @default(DRAFT)
  version     Int              @default(1)
  closedAt    DateTime?        @map("closed_at")
  closedById  String?          @map("closed_by_id") @db.VarChar(191)
  closeReason String?          @map("close_reason") @db.Text
  class       LearningClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]
  changes     AssignmentChange[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([classId, status, dueAt])
  @@index([createdById])
  @@map("assignments")
}

model AssignmentChange {
  id           String     @id @default(cuid())
  assignmentId String     @map("assignment_id")
  actorId      String     @map("actor_id") @db.VarChar(191)
  action       String     @db.VarChar(50)
  reason       String?    @db.Text
  fromVersion  Int        @map("from_version")
  toVersion    Int        @map("to_version")
  snapshot     Json
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([assignmentId, createdAt])
  @@map("assignment_changes")
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String                     @map("assignment_id")
  learnerId    String                     @map("learner_id")
  content      String                     @db.Text
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  revision     Int                        @default(1)
  submittedAt  DateTime                   @default(now()) @map("submitted_at")
  score        Decimal?                   @db.Decimal(8, 2)
  rubricScores Json?                      @map("rubric_scores")
  feedback     String?                    @db.Text
  gradedBy     String?                    @map("graded_by") @db.VarChar(191)
  gradedAt     DateTime?                  @map("graded_at")
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learner      User                       @relation("AssignmentLearner", fields: [learnerId], references: [id], onDelete: Restrict)
  attachments  AssignmentSubmissionAttachment[]
  revisions    AssignmentSubmissionRevision[]
  gradeChanges AssignmentGradeChange[]
  aiSuggestions AiGradingSuggestion[]
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  @@unique([assignmentId, learnerId])
  @@index([learnerId, status])
  @@map("assignment_submissions")
}

enum AiGradingSuggestionState {
  RETRY_AUTHORIZED
  GENERATING
  READY
  UNCERTAIN
}

model AiGradingSuggestion {
  id String @id @default(cuid())
  fingerprint String @unique @db.Char(64)
  ownerId String @map("owner_id")
  submissionId String @map("submission_id")
  contextHash String @map("context_hash") @db.Char(64)
  language String @db.VarChar(16)
  state AiGradingSuggestionState @default(GENERATING)
  result Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([ownerId, submissionId, createdAt])
  @@index([state, createdAt, id], map: "ai_grading_operations_state_created_id")
  @@map("ai_grading_suggestions")
}

model AssignmentSubmissionRevision {
  id           String               @id @default(cuid())
  submissionId String               @map("submission_id")
  revision     Int
  content      String               @db.Text
  attachments  Json
  submittedAt  DateTime             @map("submitted_at")
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now()) @map("created_at")

  @@unique([submissionId, revision])
  @@map("assignment_submission_revisions")
}

model AssignmentGradeChange {
  id               String               @id @default(cuid())
  submissionId     String               @map("submission_id")
  submissionRevision Int                @map("submission_revision")
  actorId          String               @map("actor_id") @db.VarChar(191)
  action           String               @db.VarChar(30)
  previousScore    Decimal?             @map("previous_score") @db.Decimal(8, 2)
  nextScore        Decimal              @map("next_score") @db.Decimal(8, 2)
  previousRubric   Json?                @map("previous_rubric")
  nextRubric       Json                 @map("next_rubric")
  previousFeedback String?              @map("previous_feedback") @db.Text
  nextFeedback     String               @map("next_feedback") @db.Text
  reason           String?              @db.Text
  submission       AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@map("assignment_grade_changes")
}

model AssignmentSubmissionAttachment {
  id           String               @id @default(cuid())
  submissionId String               @map("submission_id")
  objectKey    String               @unique @map("object_key") @db.VarChar(500)
  originalName String               @map("original_name") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(150)
  sizeBytes    BigInt               @map("size_bytes")
  checksum     String               @db.VarChar(128)
  removedAt    DateTime?            @map("removed_at")
  removedById  String?              @map("removed_by_id") @db.VarChar(191)
  removalError String?              @map("removal_error") @db.Text
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@map("assignment_submission_attachments")
}

model ClassAnnouncement {
  id          String        @id @default(cuid())
  classId     String        @map("class_id")
  authorId    String        @map("author_id")
  title       String        @db.VarChar(255)
  body        String        @db.Text
  publishedAt DateTime      @default(now()) @map("published_at")
  class       LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User          @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([classId, publishedAt])
  @@index([authorId])
  @@map("class_announcements")
}

model ClassInstructor {
  classId      String        @map("class_id")
  instructorId String        @map("instructor_id")
  role         InstructorAssignmentRole @default(CO_INSTRUCTOR)
  assignedBy   String        @default("usr-manager") @map("assigned_by") @db.VarChar(191)
  assignedAt   DateTime      @default(now()) @map("assigned_at")
  class        LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  instructor   User          @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@id([classId, instructorId])
  @@index([instructorId])
  @@map("class_instructors")
}

model ClassInstructorHistory {
  id           String                   @id @default(cuid())
  classId      String                   @map("class_id")
  instructorId String                   @map("instructor_id")
  role         InstructorAssignmentRole
  action       String                   @db.VarChar(30)
  reason       String?                  @db.VarChar(500)
  actorId      String                   @map("actor_id") @db.VarChar(191)
  createdAt    DateTime                 @default(now()) @map("created_at")
  class        LearningClass            @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("class_instructor_history")
}

model ClassEnrollment {
  id        String           @id @default(cuid())
  classId   String           @map("class_id")
  learnerId String           @map("learner_id")
  status    EnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now()) @map("joined_at")
  source    String           @default("MANUAL") @db.VarChar(30)
  removalReason String?      @map("removal_reason") @db.VarChar(500)
  removedAt DateTime?        @map("removed_at")
  class     LearningClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  learner   User             @relation(fields: [learnerId], references: [id], onDelete: Restrict)

  @@unique([classId, learnerId])
  @@index([learnerId, status])
  @@map("class_enrollments")
}

model ClassEnrollmentHistory {
  id        String        @id @default(cuid())
  classId   String        @map("class_id")
  learnerId String        @map("learner_id")
  action    String        @db.VarChar(30)
  source    String        @db.VarChar(30)
  reason    String?       @db.VarChar(500)
  actorId   String        @map("actor_id") @db.VarChar(191)
  createdAt DateTime      @default(now()) @map("created_at")
  class     LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("class_enrollment_history")
}

model Material {
  id               String                @id @default(cuid())
  classId          String?               @map("class_id")
  courseId         String                @map("course_id")
  ownerId          String                @map("owner_id")
  name             String                @db.VarChar(255)
  objectKey        String                @unique @map("object_key") @db.VarChar(500)
  mimeType         String                @map("mime_type") @db.VarChar(150)
  sizeBytes        BigInt                @map("size_bytes")
  checksum         String?               @db.VarChar(128)
  quarantinedAt    DateTime?             @map("quarantined_at")
  quarantineReason String?               @map("quarantine_reason") @db.VarChar(500)
  folder           String                @db.VarChar(255)
  tags             Json
  version          Int                   @default(1)
  visibility       MaterialVisibility    @default(DRAFT)
  scope            MaterialScope         @default(SHARED)
  class            LearningClass?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  course           Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  owner            User                  @relation("MaterialOwner", fields: [ownerId], references: [id])
  editors          MaterialEditor[]
  accessLogs       MaterialAccessLog[]
  forumAttachments ForumPostAttachment[]
  reviews          FileReview[]
  versions         MaterialVersion[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([classId, visibility])
  @@index([courseId, visibility])
  @@index([ownerId])
  @@index([quarantinedAt])
  @@index([classId, createdAt(sort: Desc), id])
  @@index([courseId, createdAt(sort: Desc), id])
  @@map("materials")
}

model MaterialEditor {
  materialId String   @map("material_id")
  userId     String   @map("user_id")
  grantedBy  String   @map("granted_by") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User     @relation("MaterialEditorUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([materialId, userId])
  @@index([userId])
  @@map("material_editors")
}

model MaterialVersion {
  id         String             @id @default(cuid())
  materialId String             @map("material_id")
  version    Int
  name       String             @db.VarChar(255)
  objectKey  String             @map("object_key") @db.VarChar(500)
  mimeType   String             @map("mime_type") @db.VarChar(150)
  sizeBytes  BigInt             @map("size_bytes")
  checksum   String?            @db.VarChar(128)
  folder     String             @db.VarChar(255)
  tags       Json
  visibility MaterialVisibility
  createdBy  String             @map("created_by") @db.VarChar(191)
  material   Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  aiStudyDrafts AiStudyDraft[]
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([materialId, version])
  @@index([createdAt])
  @@map("material_versions")
}

enum AiStudyDraftState {
  RETRY_AUTHORIZED
  GENERATING
  READY
  UNCERTAIN
}

model AiStudyDraft {
  id            String            @id @default(cuid())
  fingerprint   String            @unique @db.Char(64)
  ownerId       String            @map("owner_id")
  materialId    String            @map("material_id")
  sourceVersion Int               @map("source_version")
  state         AiStudyDraftState  @default(GENERATING)
  options       Json
  result        Json?
  editedResult  Json?             @map("edited_result")
  editRevision  Int               @default(0) @map("edit_revision")
  publishedResult Json?           @map("published_result")
  publishedAt DateTime?           @map("published_at")
