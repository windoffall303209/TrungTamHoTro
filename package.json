{
  "name": "trung-tam-ho-tro-giang-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wind-of-fall/web --filter @wind-of-fall/api dev",
    "dev:web": "pnpm --filter @wind-of-fall/web dev",
    "dev:api": "pnpm --filter @wind-of-fall/api dev",
    "build": "pnpm --filter @wind-of-fall/contracts build && pnpm --filter @wind-of-fall/api build && pnpm --filter @wind-of-fall/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @wind-of-fall/api db:generate",
    "db:migrate": "pnpm --filter @wind-of-fall/api db:migrate",
    "db:studio": "pnpm --filter @wind-of-fall/api db:studio"
  }
}
